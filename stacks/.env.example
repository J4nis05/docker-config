# Common Variables
PUID=1000
PGID=1000
TZ=Etc/UTC
TZ_ZURICH=Europe/Zurich
USER_ACCOUNT=USER
DEFAULT_PASSWORD=CHANGEME


# arr
# Qbittorrent
VPN_ENABLED=yes
VPN_PROV=mullvad
VPN_CLIENT=openvpn
STRICT_PORT_FORWARD=yes
ENABLE_PRIVOXY=no
WEBUI_PORT=8080
LAN_NETWORK=123.456.789.0/24
# Jellyseerr
JELLYSEERR_PORT=5055
JELLYSEERR_LOG_LEVEL=debug
# Podgrab
PODGRAB_CHECK_FREQUENCY=240


# Gitea
GITEA_DB_TYPE=mysql
GITEA_DB_HOST=gitea-db:3306
GITEA_DB_NAME=gitea


# Nextcloud
NEXTCLOUD_DB_HOST=nextcloud-db
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_REDIS_HOST=redis


# Tools
ATW_DOWNLOADER=J4nis05
ATW_PROJECT=auto
ATW_CONCURRENT=5
ATW_HOSTNAME=archiveTeamWarrior


# Matrix
MATRIX_HOST=matrix.j4nis05.ch
MATRIX_PORT=8008
MATRIX_REPORT=no
MATRIX_DB=synapse
MATRIX_DB_ARGS=--encoding=UTF8 --lc-collate=C --lc-ctype=C


# Vaultwarden
VAULTWARDEN_DB_URL=mysql://USER:CHANGEME@vaultwarden-db/vaultwarden
VAULTWARDEN_ADMIN_TOKEN=CHANGEME
VAULTWARDEN_WEBSOCKET=true
VAULTWARDEN_SIGNUPS=true
VAULTWARDEN_DB=vaultwarden


# Volume Paths
JELLYFIN_MEDIA=/nas
JELLYFIN_CONFIG=/DATADIR/arr/jellyfin/config
JELLYFIN_CACHE=/DATADIR/arr/jellyfin/cache
JELLYSEERR_CONFIG=/DATADIR/arr/jellyseerr

SONARR_CONFIG=/DATADIR/arr/sonarr
RADARR_CONFIG=/DATADIR/arr/radarr
PROWLARR_CONFIG=/DATADIR/arr/prowlarr

PODGRAB_CONFIG=/DATADIR/arr/podgrab
PODGRAB_MEDIA=/nas/media/audio/podcasts

QBITTORRENT_DOWNLOADS=/mnt/qbit
QBITTORRENT_CONFIG=/DATADIR/arr/qbittorrent/config
QBITTORRENT_THEME=/DATADIR/arr/qbittorrent/theme

GITEA_DATA=/DATADIR/gitea/data
GITEA_CONFIG=/DATADIR/gitea/config
GITEA_DATABASE=/DATADIR/gitea/database

NEXTCLOUD_HTML=/DATADIR/nextcloud/html
NEXTCLOUD_CUSTOM_APPS=/DATADIR/nextcloud/custom_apps
NEXTCLOUD_CONFIG=/DATADIR/nextcloud/config
NEXTCLOUD_DATA=/DATADIR/nextcloud/data
NEXTCLOUD_DATABASE=/DATADIR/nextcloud/database
NEXTCLOUD_REDIS=/DATADIR/nextcloud/redis

OTTERWIKI_DATA=/DATADIR/tools/otterwiki
PINGVIN_DATA=/DATADIR/tools/pingvin_data
PINGVIN_IMAGES=/DATADIR/tools/pingvin_images

ELEMENT_CONFIG=/DATADIR/matrix/element/config.json
MATRIX_DATA=/DATADIR/matrix/data
MATRIX_DATABASE=/DATADIR/matrix/database

NGINX_PROXY_DATA=/DATADIR/nginx/data
NGINX_PROXY_LETSENCRYPT=/DATADIR/nginx/letsencrypt

VAULTWARDEN_DATA=/DATADIR/vaultwarden/data
VAULTWARDEN_DATABASE=/DATADIR/vaultwarden/database

ADMIN_DATA=/DATADIR/web/admin


# Images
PORTAINER_IMAGE=portainer/portainer-ce

QBITTORRENT_IMAGE=binhex/arch-qbittorrentvpn
JELLYFIN_IMAGE=jellyfin/jellyfin
JELLYSEERR_IMAGE=fallenbagel/jellyseerr
SONARR_IMAGE=lscr.io/linuxserver/sonarr
RADARR_IMAGE=lscr.io/linuxserver/radarr
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr
PODGRAB_IMAGE=akhilrex/podgrab

GITEA_IMAGE=gitea/gitea
MARIADB_IMAGE=arm64v8/mariadb

NEXTCLOUD_IMAGE=arm64v8/nextcloud
REDIS_IMAGE=arm64v8/redis

OTTERWIKI_IMAGE=redimp/otterwiki
PINGVIN_IMAGE=stonith404/pingvin-share
ATW_IMAGE=atdr.meo.ws/archiveteam/warrior-dockerfile

ELEMENT_IMAGE=vectorim/element-web
SYNAPSE_IMAGE=matrixdotorg/synapse
POSTGRES_IMAGE=arm64v8/postgres

NGINX_PROXY_IMAGE=jc21/nginx-proxy-manager
WATCHTOWER_IMAGE=containrrr/watchtower

VAULTWARDEN_IMAGE=vaultwarden/server


# Versioning
PORTAINER_VERSION=2.26.0

QBITTORRENT_VERSION=5.0.4-3-01
JELLYFIN_VERSION=10
JELLYSEERR_VERSION=2.3.0
SONARR_VERSION=4.0.12
RADARR_VERSION=5.18.4
PROWLARR_VERSION=latest
PODGRAB_VERSION=1.0.0

GITEA_VERSION=1.23
MARIADB_VERSION=11

NEXTCLOUD_VERSION=30.0
REDIS_VERSION=alpine

OTTERWIKI_VERSION=2.9
PINGVIN_VERSION=v1.8
ATW_VERSION=latest

ELEMENT_VERSION=v1.11.92
SYNAPSE_VERSION=v1.124.0
POSTGRES_VERSION=17

NGINX_PROXY_VERSION=2
WATCHTOWER_VERSION=latest

VAULTWARDEN_VERSION=1.33.2